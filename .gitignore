# ESPHome build + secrets
/.esphome/
/secrets.yaml

# Local Python venv + runtime logs
/.venv/
/logs/

# Python caches from local external components
__pycache__/
*.pyc

# Compiled firmware images contain baked-in Wi-Fi/OTA credentials.
# Keep them local; rebuild with `python -m esphome compile`.
*.bin

# Generated by tools/build.py
/generated.build.yaml

# PyInstaller widget build artifacts (keep the .spec + build scripts, drop output)
/client/dist/
/client/build/smalltv_widget/
/client/build/generated/
*.manifest


# Downloaded sticker/GIF assets
/client/gifs/

# macOS finder droppings
.DS_Store

# Defensive: these all live outside the repo (per-user config dir), but a stray
# copy dropped in here must never be committed.
config.json
*_session.json
panel.pid
*.log
.env
.env.*
*.pem
*.key

{
  "manifest_version": 3,
  "name": "SmallTV Usage Keys",
  "short_name": "SmallTV Keys",
  "version": "1.0.0",
  "description": "Claude / Codex 세션 쿠키를 읽어 로컬 SmallTV 컨트롤 패널로 보냅니다.",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmallTV Usage Keys",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
